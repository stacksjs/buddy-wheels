@extends('layouts/buddy')
@section('title', 'Your next adventure')
<script server>
import { basket } from '~/app/Storefront/Cart'
const { items, subtotalLabel } = basket(requestContext.cookie('stacks_cart'))
const steps = [{ key: 'basket', label: 'Your basket', href: '/cart' }, { key: 'availability', label: 'Availability' }]
</script>
@section('content')
  <section class="section-space shell"><h1 class="section-title">More good days ahead.</h1><p class="mb-8 mt-4 muted">A final check before the next chapter.</p><CheckoutSteps current="availability" :steps="steps" />
    @if(items.length === 0)
      <div class="soft-panel"><h2 class="font-medium text-2xl">Start with their kind of adventure.</h2><p class="mt-4 muted">Choose a wheelchair or Rover configuration to save in your basket.</p><div class="flex flex-wrap gap-4 mt-6"><a href="/shop" class="button-primary">Explore wheelchairs</a><a href="/rover" class="button-secondary">Meet Buddy Rover</a></div></div>
    @else
      <div class="grid gap-10 items-start lg:grid-cols-[1.4fr_1fr]"><div class="soft-panel" data-launch-status><span class="availability-label">A little longer to wait.</span><h2 class="mt-4 font-medium text-3xl">Orders opening soon.</h2><p class="mt-5 muted">Your selection is saved. The final fit, care and delivery details will be published before ordering opens.</p><p class="mt-4 muted">There is no payment or reservation to make today. You can return to your basket whenever you like.</p><Button variant="bare" class="mt-7 button-primary" :disabled="true">Ordering is not open yet</Button><a href="/cart" class="block mt-6 button-text">Back to your basket</a><div class="mt-8 feature-rule"><h3 class="font-semibold">Need support for your dog now?</h3><p class="mt-3 text-sm muted">Ask your veterinarian or rehabilitation professional about suitable equipment and fitting services available today.</p></div></div><div><OrderSummary heading="Your selection" totalTitle="Items total" :items="items" :showItems="true" :subtotalLabel="subtotalLabel" shippingLabel="Not yet quoted" taxLabel="Not yet quoted" :totalLabel="subtotalLabel" /><p class="mt-4 text-xs muted">No contact or payment details are collected here.</p></div></div>
    @endif
  </section>
@endsection
