@extends('layouts/buddy')
@section('title', 'Measure their shape. Find their fit.')
@section('description', 'A visual dog wheelchair measuring guide with exact landmarks, a private measurement worksheet and printable instructions. Start with Buddy, or measure your own dog for a professional fitting.')
<script server>
import { measurementDefinitions } from '~/app/Fitting/Measurements'
const steps = measurementDefinitions
export const guideSteps = measurementDefinitions
defineClientPayload({ guideSteps })
</script>
<script client>
import { copyToClipboard } from '@stacksjs/stx/composables'
import { planningSize } from '~/app/Storefront/Catalog'
import { convertMeasurementValue, measurementErrors, measurementSummary } from '~/app/Fitting/Measurements'
const active = state('groin')
const currentStep = derived(() => guideSteps.find(step => step.id === active()) || guideSteps[0])
const diagramSrc = derived(() => '/guides/measure-' + currentStep().image + '.svg')
const diagramAlt = derived(() => currentStep().code + '. ' + currentStep().title + '. ' + currentStep().start + ' to ' + currentStep().end + '.')
const name = state('')
const breed = state('')
const worksheetUnit = state('imperial')
const bodyWeight = state('')
const groin = state('')
const hips = state('')
const body = state('')
const length = state('')
const girth = state('')
const rear = state('')
const posture = state('')
const notes = state('')
const copyStatus = state('')
const unitName = derived(() => worksheetUnit() === 'metric' ? 'cm' : 'in')
const weightUnit = derived(() => worksheetUnit() === 'metric' ? 'kg' : 'lb')
const worksheet = derived(() => ({ name: name(), breed: breed(), units: worksheetUnit() === 'metric' ? 'metric' as const : 'imperial' as const, weight: bodyWeight(), groin: groin(), hips: hips(), body: body(), length: length(), girth: girth(), rear: rear(), posture: posture(), notes: notes() }))
const errors = derived(() => measurementErrors(worksheet()))
const report = derived(() => measurementSummary(worksheet()))
function changeUnits(next: string): void {
  if (next !== 'metric' && next !== 'imperial') return
  const previous = worksheetUnit() === 'metric' ? 'metric' : 'imperial'
  batch(() => {
    for (const field of [groin, hips, body, length, girth, rear]) field.set(convertMeasurementValue(field(), previous, next))
    bodyWeight.set(convertMeasurementValue(bodyWeight(), previous, next, true))
    worksheetUnit.set(next)
    copyStatus.set('')
  })
}
function startBuddy(): void {
  batch(() => {
    name.set('Buddy')
    for (const field of [breed, groin, hips, body, length, girth, rear, posture, notes]) field.set('')
    bodyWeight.set(worksheetUnit() === 'metric' ? '63.5' : '140')
    weight.set(''); height.set(''); clearResult()
    copyStatus.set('A fresh worksheet for Buddy. His owner-reported weight is filled in; body measurements are pending.')
  })
}
async function copyMeasurements(): Promise<void> {
  const copied = await copyToClipboard(report())
  copyStatus.set(copied ? 'Worksheet copied. Paste it into your fitting conversation.' : 'Clipboard access was unavailable. Select and copy the worksheet text below.')
}
const weight = state('')
const height = state('')
const unit = state('imperial')
const result = state('')
const sizeCode = state('')
function checkSize(): void {
  const kg = unit() === 'metric'
  const suggestion = planningSize(Number(weight()) * (kg ? 2.2046226218 : 1), Number(height()) / (kg ? 2.54 : 1))
  result.set(suggestion.message)
  sizeCode.set(suggestion.code || '')
}
function clearResult(): void { result.set(''); sizeCode.set('') }
function useWorksheet(): void {
  if (errors().length || !rear() || !bodyWeight()) return
  batch(() => { weight.set(bodyWeight()); height.set(rear()); unit.set(worksheetUnit()); clearResult() })
}
</script>
@section('content')
<div class="fit-page shell">
  <header class="fit-heading"><h1>Measure their shape.<br>Make room for life.</h1><p class="muted">See exactly where to measure, then keep a clear record for their fitting.</p><a href="/guides/buddy-wheels-measuring-guide.pdf" class="button-text fit-print-link" download><i class="i-hugeicons-download-01" aria-hidden="true"></i>Download the illustrated guide &amp; worksheet</a></header>
  <aside class="fit-care"><strong>Comfort comes first.</strong><p>Use only a posture your vet or rehabilitation professional approves. Never force standing or straighten a painful limb. New or sudden loss of hind-leg use needs urgent veterinary assessment; measuring must not delay care.</p></aside>
  <section class="fit-visual-guide" aria-labelledby="measurement-heading">
    <div class="fit-section-heading"><h2 id="measurement-heading">One landmark at a time.</h2><p class="muted">Select a measurement to see its start and end points. These are body measurements, with no added frame clearance.</p></div>
    <fieldset class="fit-step-picker"><legend class="sr-only">Choose a measurement illustration</legend><div class="fit-step-options">@foreach (steps as step)
      <label><input type="radio" name="measurement-step" value="{{ step.id }}" :checked="active() === '{{ step.id }}'" @change="active.set('{{ step.id }}')"><span><strong>{{ step.code }}</strong>{{ step.title }}</span></label>
    @endforeach</div></fieldset>
    <div class="fit-guide-grid">
      <figure class="fit-diagram"><div class="fit-diagram-heading"><strong>{{ currentStep().view }}</strong><span>Schematic, not to scale</span></div><img src="/guides/measure-a-groin-height.svg" :src="diagramSrc()" :alt="diagramAlt()" width="640" height="400"><figcaption><span>From</span> {{ currentStep().start }}<br><span>To</span> {{ currentStep().end }}</figcaption></figure>
      <div class="fit-instructions" aria-live="polite"><span class="fit-measure-code">{{ currentStep().code }}</span><h3>{{ currentStep().title }}</h3><p>{{ currentStep().method }}</p><dl><div><dt>Use</dt><dd>{{ currentStep().tool }}</dd></div><div><dt>Keep it accurate</dt><dd>{{ currentStep().avoid }}</dd></div></dl><p class="fit-method-note">{{ currentStep().note }}</p></div>
    </div>
    <noscript><p>All six illustrated steps are available in the printable guide above and the <a href="/measurement-handbook">full measuring handbook</a>.</p></noscript>
    <p class="fit-source-note">Our A-E codes belong to this worksheet. Methods are informed by <a href="https://walkinpets.com/pages/wheelchair-sizer/">Walkin’ Pets’ lying measurement guide</a> and <a href="https://eddieswheels.com/files/A_Visual_Guide_to_Measuring_Your_Pet_-_Eddies_Wheels_for_Pets_-_The_Pet_Mobility_Experts.pdf">Eddie’s Wheels’ supported measurement guide</a>. For chest girth, see <a href="https://ruffwear.com/blogs/explored/the-size-is-right-how-to-measure-for-your-dogs-gear">Ruffwear’s girth-measuring explanation</a>. Brand ordering forms use different landmarks and codes.</p>
  </section>
  <section class="fit-worksheet" aria-labelledby="worksheet-heading">
    <div class="fit-section-heading"><h2 id="worksheet-heading">Their numbers, all together.</h2><p class="muted">Leave anything you cannot measure comfortably pending. Entries stay in this page until you copy them; they are not sent or saved automatically.</p></div>
    <div class="fit-worksheet-tools"><fieldset><legend>Record measurements in</legend><div class="fit-unit-options"><label><input type="radio" name="worksheet-unit" value="imperial" :checked="worksheetUnit() === 'imperial'" @change="changeUnits('imperial')"><span>Inches &amp; lb</span></label><label><input type="radio" name="worksheet-unit" value="metric" :checked="worksheetUnit() === 'metric'" @change="changeUnits('metric')"><span>Centimeters &amp; kg</span></label></div></fieldset><button type="button" class="button-text" @click="startBuddy()" data-start-buddy title="Replaces all entries with Buddy’s name and owner-reported weight">Reset worksheet for Buddy</button></div>
    <div class="fit-worksheet-grid">
      <div class="fit-record-fields" @input="copyStatus.set('')">
        <div class="fit-field-grid"><div class="field"><label for="fit-name">Dog’s name</label><input id="fit-name" type="text" maxlength="80" autocomplete="off" x-model="name"></div><div class="field"><label for="fit-breed">Breed or mix</label><input id="fit-breed" type="text" maxlength="120" autocomplete="off" x-model="breed"></div></div>
        <div class="fit-field-grid"><div class="field"><label for="fit-weight">Current weight ({{ weightUnit() }})</label><input id="fit-weight" type="number" min="0.1" step="any" x-model="bodyWeight"><small>Buddy’s recorded 140 lb is owner reported, not a scale reading.</small></div><div class="field"><label for="fit-groin">A. Supported groin height ({{ unitName() }})</label><input id="fit-groin" type="number" min="0.1" step="any" x-model="groin"><small>Floor to groin, in the approved supported posture.</small></div></div>
        <div class="fit-field-grid"><div class="field"><label for="fit-hips">B1. Hip width ({{ unitName() }})</label><input id="fit-hips" type="number" min="0.1" step="any" x-model="hips"><small>Straight across the body at the hips.</small></div><div class="field"><label for="fit-body">B2. Widest body width ({{ unitName() }})</label><input id="fit-body" type="number" min="0.1" step="any" x-model="body"><small>Largest of shoulders, ribs and hips. Note which one.</small></div></div>
        <div class="fit-field-grid"><div class="field"><label for="fit-length">C. Armpit-to-rump length ({{ unitName() }})</label><input id="fit-length" type="number" min="0.1" step="any" x-model="length"><small>A straight line, excluding neck and tail.</small></div><div class="field"><label for="fit-girth">D. Chest girth ({{ unitName() }})</label><input id="fit-girth" type="number" min="0.1" step="any" x-model="girth"><small>All the way around, behind the front legs.</small></div></div>
        <div class="field"><label for="fit-rear">E. Lying rear-leg measurement ({{ unitName() }}), optional</label><input id="fit-rear" type="number" min="0.1" step="any" x-model="rear"><small>Groin to hind paw pad with a natural bend. Never substitute this number for A.</small></div>
        <div class="field"><label for="fit-posture">Supported posture, helper and measurement date</label><input id="fit-posture" type="text" maxlength="300" x-model="posture" placeholder="For example: approved sling support, two helpers, November 8"></div>
        <div class="field"><label for="fit-notes">Widest location, asymmetry or other notes</label><textarea id="fit-notes" rows="3" maxlength="1000" x-model="notes"></textarea></div>
      </div>
      <aside class="fit-record-summary"><h3>A record you can share.</h3><p class="muted">Copy this into your fitting conversation. Missing numbers remain clearly marked.</p><textarea id="fit-summary" aria-label="Copyable body measurement worksheet" readonly rows="21" :value="report()"></textarea><p class="fit-validation" :if="errors().length" role="alert">{{ errors().join(' ') }}</p><Button variant="bare" type="button" class="w-full button-primary" :disabled="errors().length > 0" @click="copyMeasurements()" data-copy-measurements><i class="i-hugeicons-copy-01" aria-hidden="true"></i>Copy measurements</Button><p class="fit-copy-status" role="status">{{ copyStatus() }}</p></aside>
    </div>
    <div class="fit-anatomy-note"><h3>Body numbers are the beginning.</h3><p>A groin height is not a rail-center height. Harness position, padding, clearance, suspension movement and tire deflection are separate design inputs. Measurements do not approve a fit or automatically change the CAD.</p><a href="/design-studio-xl" class="button-text">Inspect Buddy’s configurable XL design</a></div>
  </section>
  <section id="size-helper" class="fit-size-section" aria-labelledby="size-heading"><div class="fit-section-heading"><h2 id="size-heading">Find a starting size.</h2><p class="muted">This helper uses weight and E, the lying rear-leg measurement. It does not use supported groin height.</p></div>
    <div class="fit-size-grid"><div class="soft-panel"><form class="space-y-5" @submit.prevent="checkSize()"><div class="field"><label for="units">Measurement units</label><select id="units" x-model="unit" @change="clearResult()"><option value="imperial">Pounds &amp; inches</option><option value="metric">Kilograms &amp; centimeters</option></select></div><div class="grid gap-5 sm:grid-cols-2"><div class="field"><label for="weight">Weight ({{ unit() === 'metric' ? 'kg' : 'lb' }})</label><input id="weight" type="number" min="0.1" step="any" required x-model="weight" @input="clearResult()"></div><div class="field"><label for="height">E. Lying rear-leg measurement ({{ unit() === 'metric' ? 'cm' : 'in' }})</label><input id="height" type="number" min="0.1" step="any" required x-model="height" @input="clearResult()"></div></div><Button type="submit" variant="bare" class="button-primary">Find their starting size</Button></form><button type="button" class="button-text fit-use-record" :disabled="!rear() || !bodyWeight() || errors().length > 0" @click="useWorksheet()">Use weight and E from the worksheet</button><div aria-live="polite" role="status" class="mt-6"><p data-fit-result>{{ result() }}</p><a :if="sizeCode()" :href="'/shop?size=' + sizeCode()" class="inline-flex mt-4 button-text">Explore this size</a></div></div><div class="fit-size-notes"><h3>A starting point, followed by a fitting.</h3><p>Body shape, front-leg strength, posture and the selected support system all matter. Your professional can assess whether rear-only support is suitable.</p><p>The helper’s proposed size ranges are not tested load ratings. A matching result does not confirm that a chair is safe or appropriate for your dog.</p><a href="/care" class="button-text">Care for every outing</a></div></div>
  </section>
  <section id="rover" class="fit-rover-note"><div><h2>Room to ride in Buddy Rover.</h2><p>Measure comfortable seated height, lying length and shoulder width for a cabin. Wheelchair body measurements do not select a Rover cabin; final cabin dimensions and load limits will be published before orders open.</p><a href="/rover" class="button-text">Explore Buddy Rover</a></div><div><h2>Planning to build a prototype?</h2><p>The printer is one part of the cost. Our XL budget includes the metal frame, hardware, suspension, supports, tools and development allowances.</p><a href="/prototype-budget" class="button-text">See the complete XL build budget</a></div></section>
</div>
@endsection
