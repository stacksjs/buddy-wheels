@extends('layouts/buddy')
@section('title', 'Your basket')
<script server>
import { basket } from '~/app/Storefront/Cart'
const { items, subtotalLabel } = basket(requestContext.cookie('stacks_cart'))
const limitNotice = requestContext.query().notice === 'quantity-limit'
</script>
<script client>
const updating = state(false)
function updateQuantity(event: Event): void {
  const input = event.target as HTMLInputElement
  if (input.form && !updating()) {
    updating.set(true)
    input.form.requestSubmit()
  }
}
</script>
@section('content')
  <section class="section-space shell"><h1 class="section-title">Good days, in the bag.</h1><p class="mt-4 muted">Your selection, saved together. Make it just right before the next step.</p>
    @if(limitNotice)
      <p class="mt-6 notice" role="status">You can add up to five of each configuration. Update a quantity below to make room.</p>
    @endif
    @if(items.length === 0)
      <div class="mt-10 py-12 soft-panel"><h2 class="font-medium text-2xl">Their next adventure starts here.</h2><p class="mt-3 muted">A little support to walk, or a comfortable place to ride.</p><div class="flex flex-wrap gap-4 mt-6"><a href="/shop" class="button-primary">Find their wheels</a><a href="/rover" class="button-secondary">Meet Buddy Rover</a></div></div>
    @else
      <div class="grid gap-10 items-start lg:grid-cols-[1.6fr_1fr] mt-10"><div>
        <p :if="updating()" role="status" class="text-sm muted">Updating your basket...</p>
        @foreach(items as item)
          <article class="basket-row" data-basket-line="{{ item.slug }}"><a href="{{ item.href }}"><img src="{{ item.image }}" alt="{{ item.name }}" width="100" height="100"></a><div><h2 class="font-semibold text-lg"><a href="{{ item.href }}">{{ item.name }}</a></h2><p class="finish-summary"><span class="finish-dot" style="background:{{ item.finish.accent }}" aria-hidden="true"></span>Covers {{ item.finish.accent }}<span class="finish-dot" style="background:{{ item.finish.trim }}" aria-hidden="true"></span>Trim {{ item.finish.trim }}</p><form action="/api/cart/update" method="POST" class="flex flex-wrap gap-3 items-center mt-4" @change="updateQuantity"><input type="hidden" name="item_id" value="{{ item.id }}"><QuantitySelector :value="item.qty" :min="0" :max="5" label="Basket quantity" /><Button type="submit" variant="bare" class="button-secondary">Update</Button></form><form action="/api/cart/update" method="POST" class="mt-3"><input type="hidden" name="item_id" value="{{ item.id }}"><input type="hidden" name="quantity" value="0"><button type="submit" class="text-xs button-text">Remove</button></form></div><p class="font-semibold">{{ item.lineTotalLabel }}</p></article>
        @endforeach
        <div class="flex flex-wrap gap-6 mt-8"><a href="/shop" class="button-text">Wheelchairs</a><a href="/rover" class="button-text">Buddy Rover</a></div>
      </div><div><OrderSummary heading="Your basket" totalTitle="Items total" :subtotalLabel="subtotalLabel" shippingLabel="Not yet quoted" taxLabel="Not yet quoted" :totalLabel="subtotalLabel" ctaHref="/checkout" ctaLabel="Check availability" secondaryHref="/fit-guide" secondaryLabel="Review their fit" /><p class="mt-4 text-xs muted">Prices are in USD, before tax and delivery. Your basket is saved for up to 30 days.</p><p class="mt-5 text-sm muted"><span class="availability-dot" aria-hidden="true"></span>Orders opening soon. Nothing is charged today.</p></div></div>
    @endif
  </section>
@endsection
