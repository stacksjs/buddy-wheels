@extends('layouts/buddy')
@section('title', 'Your planning basket')
<script server>
import { basket } from '~/app/Storefront/Cart'
const { items, subtotalLabel } = basket(requestContext.cookie('stacks_cart'))
const limitNotice = requestContext.query().notice === 'quantity-limit'
</script>
@section('content')
  <section class="section-space shell">
    <h1 class="section-title">A little closer to their next walk.</h1>
    <p class="mt-4 muted">Your planning basket. No payment, reservation or order is created.</p>
    @if(limitNotice)
      <p class="mt-6 notice" role="status">Your planning basket can contain up to five of each size. You can update or remove a configuration below.</p>
    @endif
    @if(items.length === 0)
      <div class="mt-10 py-12 soft-panel"><h2 class="font-medium text-xl">Your basket has room for a plan.</h2><p class="mt-3 muted">Choose a planned wheelchair size to explore the experience.</p><a href="/shop" class="mt-6 button-primary">Explore the wheelchairs</a></div>
    @else
      <div class="grid gap-10 items-start lg:grid-cols-[1.6fr_1fr] mt-10">
        <div>
          @foreach(items as item)
            <article class="basket-row"><img src="/images/chair-concept-640.webp" alt="Proposed Buddy Wheels chair, AI concept" width="100" height="100"><div><h2 class="font-semibold text-lg">{{ item.name }}</h2><p class="mt-2 text-xs muted">Development concept</p><form action="/api/cart/update" method="POST" class="flex flex-wrap gap-3 items-center mt-4"><input type="hidden" name="item_id" value="{{ item.id }}"><QuantitySelector :value="item.qty" :min="0" :max="5" label="Basket quantity, set zero to remove" /><Button type="submit" variant="outline">Update</Button></form><p class="mt-2 text-xs muted">Set quantity to 0 to remove this configuration.</p></div><p class="font-semibold">{{ item.lineTotalLabel }}</p></article>
          @endforeach
          <a href="/shop" class="inline-flex mt-8 button-text">Keep exploring sizes</a>
        </div>
        <div><OrderSummary :subtotalLabel="subtotalLabel" shippingLabel="Not quoted" :totalLabel="subtotalLabel" ctaHref="/checkout" ctaLabel="Preview next steps" secondaryHref="/fit-guide" secondaryLabel="Review the fit guide" /><p class="mt-4 text-xs muted">Total shown is the product target subtotal only. Delivery and tax are unquoted. Nothing will be charged.</p></div>
      </div>
    @endif
    <div class="mt-10 notice">If your dog needs help today, please contact a vet or rehabilitation professional about a currently available, fitted mobility aid.</div>
  </section>
@endsection
