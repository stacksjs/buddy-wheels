<script server>
import { file, hash } from 'bun'
import { basket } from '~/app/Storefront/Cart'
const navBasket = basket(requestContext.cookie('stacks_cart'))
const basketCount = navBasket.items.reduce((sum, item) => sum + item.qty, 0)
const stylesheetRevision = hash(await file('public/assets/buddy.css').arrayBuffer()).toString(36)
</script>
<!DOCTYPE html>
<html lang="en">
<head>
