      <a href="/" class="flex gap-2 items-center wordmark" aria-label="Buddy Wheels home"><i class="text-2xl i-hugeicons-paw" aria-hidden="true"></i>buddy<span>wheels</span></a>
      <div class="hidden md:flex gap-8 items-center font-medium text-sm"><a href="/shop">Wheelchairs</a><a href="/rover">Buddy Rover</a><a href="/fit-guide">Find their fit</a><a href="/our-story">Our story</a></div>
      <a href="/cart" class="flex gap-2 items-center font-medium text-sm basket-link"><i class="text-xl i-hugeicons-shopping-bag-01" aria-hidden="true"></i>Basket<span class="basket-count" data-cart-count>{{ basketCount }}</span></a>
    </nav>
    <nav aria-label="Mobile navigation" class="flex md:hidden justify-between pb-4 px-5 text-sm mobile-nav"><a href="/shop">Wheelchairs</a><a href="/rover">Rover</a><a href="/fit-guide">Fit guide</a><a href="/our-story">Our story</a></nav>
  </header>
  <main id="main">@yield('content')</main>
  <footer class="site-footer">
    <div class="grid gap-10 md:grid-cols-2 py-12 shell">
      <div><a href="/" class="wordmark">buddy<span>wheels</span></a><p class="mt-3 max-w-sm text-sm muted">A little support for a life well loved.<br>Started for Buddy. Built around dogs.</p></div>
      <div class="grid gap-6 grid-cols-2 text-sm"><div class="space-y-3"><a class="block" href="/fit-guide">Measuring &amp; fitting</a><a class="block" href="/care">Care &amp; safety</a><a class="block" href="/policies">Delivery &amp; returns</a></div><div class="space-y-3"><a class="block" href="/journal">Designed to keep going</a><a class="block" href="/policies#privacy">Privacy</a><a class="block" href="https://github.com/stacksjs/buddy-wheels">Inside Buddy Wheels</a></div></div>
