  <meta property="og:title" content="@yield('title', 'More walks. More together.') | Buddy Wheels">
  <meta property="og:description" content="@yield('description', 'Support their stride. Bring them along. Find their next adventure with Buddy Wheels.')">
  <meta property="og:image" content="@yield('social_image', 'https://buddywheels.org/images/buddy-meadow.webp')">
  <meta name="theme-color" content="#234b38">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/buddy.css?v={{ stylesheetRevision }}">
  @yield('head')
</head>
<body class="antialiased">
  <a href="#main" class="skip-link">Skip to content</a>
  <div class="px-4 py-2 text-center text-xs sm:text-sm announcement">For the dogs who still have places to go.</div>
