@extends('layouts/buddy')
@section('title', 'Wheelchair 3D design studio')
@section('description', 'Explore every Buddy wheelchair size in 3D, from XS to XL. Configure frame dimensions and suspension, inspect printable parts and download matching assembly instructions.')
@section('social_image', 'https://buddywheels.org/designs/xl/r0/assembly.png')
<script server>
import { splitFinish as splitServerFinish, finishQuery as serverFinishQuery, defaultFinish as serverDefaultFinish } from '~/app/Storefront/Finish'
export let initialFinish = serverDefaultFinish
try { initialFinish = splitServerFinish(requestContext.query()).finish } catch {}
const finishForm = 'studio-download'
import { publicPath } from '@stacksjs/path'
import { parseStudioSetup as parseServerSetup, parseStudioSize as parseServerSize, studioStartingSetup as startingServerSetup, studioSetupQuery as serverSetupQuery, studioPartNames as serverPartNames, studioSizes as serverSizes, studioSizeNames as serverSizeNames, studioDimensionLimits as serverLimits } from '~/app/Designs/StudioSetup'
import { cadParts } from '~/app/Designs/WheelchairParameters'
export const assetRevisions = Object.fromEntries(await Promise.all(serverSizes.map(async size => [size, (await Bun.file(publicPath('designs/' + size.toLowerCase() + '/r0/manifest.json')).json()).sourceHash.slice(0, 16)])))
const parts = cadParts.map(part => ({ ...part, name: serverPartNames[part.id] || part.id }))
const printParts = parts.filter(part => part.category !== 'metal')
const metalParts = parts.filter(part => part.category === 'metal')
const sizeChoices = serverSizes.map(size => ({ size, name: serverSizeNames[size] }))
export let initialSetup = startingServerSetup('XL')
export let initialError = ''
try {
  const { size = 'XL', ...fields } = splitServerFinish(requestContext.query()).configuration
  const selected = parseServerSize(size)
  initialSetup = startingServerSetup(selected)
  initialSetup = parseServerSetup(fields, selected)
}
catch { initialError = 'Those settings could not be loaded. The selected family’s starting dimensions are shown.' }
const initialLimits = serverLimits[initialSetup.size]
const initialAssetRoot = '/designs/' + initialSetup.size.toLowerCase() + '/r0'
const initialRevision = assetRevisions[initialSetup.size]
const initialEndpoint = '/api/designs/' + initialSetup.size.toLowerCase()
const initialAssembly = initialEndpoint + '/assembly?' + serverSetupQuery(initialSetup) + '&' + serverFinishQuery(initialFinish)
defineClientPayload({ initialFinish, assetRevisions, initialSetup, initialError })
</script>
<script client>
import { finishScene, finishQuery } from '~/app/Storefront/Finish'
const accent = state(initialFinish.accent)
const trim = state(initialFinish.trim)
const finish = derived(() => ({ accent: accent(), trim: trim() }))
import type { StudioSetup, StudioSize } from '~/app/Designs/StudioSetup'
import { createStudioScene } from '~/app/Designs/StudioScene'
import { parseStudioSetup, parseStudioSize, studioStartingSetup, studioSetupQuery, studioSetupFamily, studioPartNames, studioDimensionLimits, studioSizeNames } from '~/app/Designs/StudioSetup'
const size = state<StudioSize>(initialSetup.size)
const saved = state<Partial<Record<StudioSize, StudioSetup>>>({})
const height = state(initialSetup.height)
const width = state(initialSetup.width)
const rail = state(initialSetup.rail)
const setting = state(initialSetup.setting)
const travel = state(initialSetup.travel)
const locked = state(initialSetup.locked)
const focus = state('assembly')
const exploded = state(false)
const modelArea = useRef('modelArea')
const lastValid = state(initialSetup)
const parsed = derived(() => {
  try { return { value: parseStudioSetup({ height: height(), width: width(), rail: rail(), setting: setting(), travel: travel(), locked: locked() }, size()), error: '' } }
  catch (error) { return { value: null, error: error instanceof Error ? error.message : 'Check your dimensions.' } }
})
effect(() => { if (locked()) travel.set(0) })
effect(() => { const next = parsed().value; if (next) lastValid.set(next) })
const family = derived(() => studioSetupFamily(lastValid()))
const limits = derived(() => studioDimensionLimits[size()])
const poster = derived(() => '/designs/' + size().toLowerCase() + '/r0/assembly.png?v=' + assetRevisions[size()])
const modelLabel = derived(() => 'Buddy ' + size() + ' adjustable wheelchair bench design')
const scene = derived(() => finishScene(createStudioScene(lastValid(), focus(), exploded(), assetRevisions[lastValid().size]), finish()))
const sceneName = derived(() => focus() === 'assembly' ? 'Complete ' + size() + ' frame' : focus() === 'suspension' ? size() + ' suspension detail' : size() + ' · ' + (studioPartNames[focus()] || 'Wheelchair part'))
const query = derived(() => studioSetupQuery(lastValid()) + '&' + finishQuery(finish()))
const endpoint = derived(() => '/api/designs/' + size().toLowerCase())
const sizeName = derived(() => studioSizeNames[size()])
const assemblyUrl = derived(() => endpoint() + '/assembly?' + query())
const profileUrl = derived(() => endpoint() + '/profile?' + query())
const rate = derived(() => (family().radii[Number(setting())] / family().arm) ** 2)
const inches = (mm: number) => (Number(mm) / 25.4).toFixed(1)
function partUrl(id: string): string { return endpoint() + '/part/' + id + '?v=' + assetRevisions[size()] }
function inspect(part: string): void {
  focus.set(part)
  void nextTick(() => { modelArea.current?.scrollIntoView({ block: 'start', behavior: 'instant' }); modelArea.current?.focus({ preventScroll: true }) })
}
function applySetup(next: StudioSetup): void {
  batch(() => { size.set(next.size); height.set(next.height); width.set(next.width); rail.set(next.rail); setting.set(next.setting); travel.set(next.travel); locked.set(next.locked); lastValid.set(next) })
}
function selectSize(value: string): void {
  const next = parseStudioSize(value)
  if (next === size()) return
  saved.update(previous => ({ ...previous, [lastValid().size]: lastValid() }))
  applySetup(saved()[next] || studioStartingSetup(next))
}
function reset(): void {
  applySetup(studioStartingSetup(size()))
  batch(() => { focus.set('assembly'); exploded.set(false) })
}
</script>
@section('content')
  <div class="design-studio shell">
    <header class="studio-heading">
      <a href="/shop?size={{ initialSetup.size }}" :href="'/shop?size=' + size()" class="studio-back"><i class="i-hugeicons-arrow-left-01" aria-hidden="true"></i>Back to wheelchairs</a>
      <h1>Every size. Every angle.</h1>
      <p class="muted">Adjust the frame. Look closer at the suspension. Keep the parts and build notes together.</p>
      <div class="studio-context"><span :if="size() === 'XL'">Buddy · 140 lb, owner reported</span><span>{{ size() }} bench design</span><span>Dimensions in millimeters</span></div>
    </header>
    <p class="studio-query-note" :if="initialError">{{ initialError }}</p>
    <fieldset class="studio-size-selector"><legend>Choose a frame size</legend><div class="studio-size-options">@foreach (sizeChoices as choice)
      <label><input type="radio" name="studio-size" value="{{ choice.size }}" :checked="String(size()) === '{{ choice.size }}'" @change="selectSize('{{ choice.size }}')" aria-label="{{ choice.name }} ({{ choice.size }})"><span><strong>{{ choice.size }}</strong><small>{{ choice.name }}</small></span></label>
    @endforeach</div><p class="muted">Each size keeps your edits while you compare. Frame sizes are starting points for a measured fit.</p><span class="sr-only" role="status" aria-live="polite">{{ sizeName() }} bench design selected.</span></fieldset>
    <aside class="standard-r1-notice" :if="size() === 'XL'"><strong>New: the XL standard-parts redesign.</strong> r1 removes the costly shock platform for a simpler rigid base. <a href="/design-studio-xl" :href="'/design-studio-xl' + '?' + finishQuery(finish())">Inspect XL r1 and its per-chair cost</a>. <a href="/design-studio-xl-suspension" :href="'/design-studio-xl-suspension' + '?' + finishQuery(finish())">Explore r2 with standard die springs and adjustable preload</a>. This page retains the separate r0 adjustable-suspension research.</aside>
    <div class="studio-workbench">
      <section ref="modelArea" tabindex="-1" class="studio-visual" aria-label="3D inspection">
        <div class="studio-view-heading"><h2>{{ sceneName() }}</h2><label class="studio-check"><input type="checkbox" x-model="exploded" :disabled="focus() !== 'assembly' && focus() !== 'suspension'">Separate plates</label></div>
        <ModelViewer :scene="scene()" :label="modelLabel()" :poster="poster()" className="buddy-model" />
        <noscript><img src="{{ initialAssetRoot }}/assembly.png" alt="Buddy {{ initialSetup.size }} bench frame drawing" width="1400" height="1000" class="studio-noscript"><p>Enable JavaScript for interactive 3D. The starting-design kit remains available below.</p></noscript>
        <div class="studio-view-options" role="group" aria-label="Inspection scope"><button type="button" :aria-pressed="focus() === 'assembly'" @click="focus.set('assembly')">Whole frame</button><button type="button" :aria-pressed="focus() === 'suspension'" @click="focus.set('suspension')">Suspension close-up</button></div>
        <dl class="studio-readout"><div><dt>Inside rail clearance</dt><dd><strong>{{ lastValid().width - family().tube }}</strong> <span>mm</span></dd></div><div><dt>Overall tire width</dt><dd><strong>{{ lastValid().width + 2 * family().wheelOffset + family().tireWidth }}</strong> <span>mm</span></dd></div><div><dt>Individual part print bed</dt><dd>220 × 220 <span>mm</span></dd></div></dl>
        <p class="muted studio-model-note">Metal frame and suspension cheeks. Printable service parts. Pins, wheels and shock are nominal envelopes; the fitted harness and full guarding are still to be designed.</p>
      </section>
      <aside class="studio-controls" aria-label="Wheelchair design controls">
        <div class="studio-control-heading"><h2>Shape their frame.</h2><button type="button" class="studio-reset" @click="reset()">Reset setup</button></div>
        <p class="muted studio-intro">{{ size() === 'XL' ? 'Buddy’s starting estimate for a very big dog.' : sizeName() + ' family starting geometry.' }} These are frame dimensions, not body measurements.</p>
        <fieldset class="studio-fieldset"><legend>Frame dimensions</legend>
          <div class="studio-field"><div class="studio-field-title"><label for="studio-height">Rail center height</label><div class="studio-number"><input id="studio-height" name="height" form="studio-download" type="number" value="{{ initialSetup.height }}" min="{{ initialLimits.height[0] }}" max="{{ initialLimits.height[1] }}" :min="limits().height[0]" :max="limits().height[1]" step="5" required x-model.number="height"><span>mm</span></div></div><input type="range" aria-label="Rail center height slider" min="{{ initialLimits.height[0] }}" max="{{ initialLimits.height[1] }}" :min="limits().height[0]" :max="limits().height[1]" step="5" value="{{ initialSetup.height }}" x-model.number="height"><p><span>{{ limits().height[0] }}-{{ limits().height[1] }} mm</span> <span>{{ inches(height()) }} in</span></p></div>
          <div class="studio-field"><div class="studio-field-title"><label for="studio-width">Rail center spacing</label><div class="studio-number"><input id="studio-width" name="width" form="studio-download" type="number" value="{{ initialSetup.width }}" min="{{ initialLimits.width[0] }}" max="{{ initialLimits.width[1] }}" :min="limits().width[0]" :max="limits().width[1]" step="5" required x-model.number="width"><span>mm</span></div></div><input type="range" aria-label="Rail center spacing slider" min="{{ initialLimits.width[0] }}" max="{{ initialLimits.width[1] }}" :min="limits().width[0]" :max="limits().width[1]" step="5" value="{{ initialSetup.width }}" x-model.number="width"><p><span>{{ limits().width[0] }}-{{ limits().width[1] }} mm</span> <span>{{ inches(width()) }} in</span></p></div>
          <div class="studio-field"><div class="studio-field-title"><label for="studio-rail">Side rail length</label><div class="studio-number"><input id="studio-rail" name="rail" form="studio-download" type="number" value="{{ initialSetup.rail }}" min="{{ initialLimits.rail[0] }}" max="{{ initialLimits.rail[1] }}" :min="limits().rail[0]" :max="limits().rail[1]" step="5" required x-model.number="rail"><span>mm</span></div></div><input type="range" aria-label="Side rail length slider" min="{{ initialLimits.rail[0] }}" max="{{ initialLimits.rail[1] }}" :min="limits().rail[0]" :max="limits().rail[1]" step="5" value="{{ initialSetup.rail }}" x-model.number="rail"><p><span>{{ limits().rail[0] }}-{{ limits().rail[1] }} mm</span> <span>{{ inches(rail()) }} in</span></p></div>
        </fieldset>
        <fieldset class="studio-fieldset"><legend>Suspension geometry</legend><p class="muted studio-help">Matched upper and lower eye positions. Larger leverage gives a firmer ideal response with the same spring.</p>
          <div class="studio-leverage"><label><input type="radio" name="setting" form="studio-download" value="0" x-model.number="setting"><span><strong>A</strong><small>{{ family().radii[0] }} mm · softer</small></span></label><label><input type="radio" name="setting" form="studio-download" value="1" x-model.number="setting"><span><strong>B</strong><small>{{ family().radii[1] }} mm · middle</small></span></label><label><input type="radio" name="setting" form="studio-download" value="2" x-model.number="setting"><span><strong>C</strong><small>{{ family().radii[2] }} mm · firmer</small></span></label></div>
          <p class="studio-rate">Ideal wheel rate: <strong>{{ rate().toFixed(3) }} ×</strong> shock spring rate at neutral.</p>
          <div class="studio-travel"><label for="studio-travel">Travel preview <output>{{ travel() }}°</output></label><input id="studio-travel" name="travel" form="studio-download" type="range" min="-3" max="6" step="0.5" value="{{ initialSetup.travel }}" x-model.number="travel" :disabled="locked()"><div class="studio-range-ends"><span>Droop, -3°</span><span>Bump, +6°</span></div></div>
          <label class="studio-lock"><input type="checkbox" name="locked" form="studio-download" value="true" x-model="locked"><span><strong>Show the neutral lock installed</strong><small>Holds the inspection pose at zero travel.</small></span></label>
        </fieldset>
        @include('../partials/finish-controls')
        <p class="studio-validation" :if="parsed().error" role="alert">{{ parsed().error }} The preview keeps your last valid setup.</p>
        <form id="studio-download" class="studio-download" action="{{ initialEndpoint }}/kit" :action="endpoint() + '/kit'" method="GET"><Button type="submit" variant="bare" class="w-full button-primary" :disabled="!parsed().value"><i class="i-hugeicons-download-01" aria-hidden="true"></i>Download this setup</Button></form>
        <p class="muted studio-download-note">STLs, metal DXFs, editable CAD, parts list and assembly notes. Your frame dimensions are included.</p>
        <div class="studio-file-links"><a href="{{ initialAssembly }}" :href="assemblyUrl()">Assembly notes (.md)</a><a :href="profileUrl()">Setup file (.json)</a></div>
      </aside>
    </div>
    <section class="studio-parts" aria-labelledby="studio-parts-heading">
      <div class="studio-section-heading"><h2 id="studio-parts-heading">A closer look at every part.</h2><p class="muted">Each part below belongs to your selected {{ size() }} family. Inspect its actual mesh or download the STL on its own.</p></div>
      <div class="studio-parts-grid">@foreach (printParts as part)
        <article class="studio-part" :class="focus() === '{{ part.id }}' ? 'studio-part-active' : ''"><div><span class="studio-part-category">{{ part.category === 'fixture' ? 'Bench fixture' : 'Printable service part' }} · Qty {{ part.qty }}</span><h3>{{ part.name }}</h3><p>{{ part.purpose }}</p></div><div class="studio-part-actions"><button type="button" @click="inspect('{{ part.id }}')" :aria-pressed="focus() === '{{ part.id }}'">Inspect in 3D</button><a href="{{ initialEndpoint }}/part/{{ part.id }}?v={{ initialRevision }}" :href="partUrl('{{ part.id }}')" download aria-label="Download {{ part.name }} STL">STL<i class="i-hugeicons-download-01" aria-hidden="true"></i></a></div></article>
      @endforeach</div>
      <details class="studio-metal"><summary>Metal structural parts and their fit-check copies</summary><p>These STL copies are unloaded layout gauges. The load-bearing counterparts are metal; matching DXF profiles are in the full kit.</p><div class="studio-parts-grid">@foreach (metalParts as part)
        <article class="studio-part"><div><span class="studio-part-category">Metal part · Qty {{ part.qty }}</span><h3>{{ part.name }}</h3></div><div class="studio-part-actions"><button type="button" @click="inspect('{{ part.id }}')">Inspect in 3D</button><a href="{{ initialEndpoint }}/part/{{ part.id }}?v={{ initialRevision }}" :href="partUrl('{{ part.id }}')" download>Fit-check STL<i class="i-hugeicons-download-01" aria-hidden="true"></i></a></div></article>
      @endforeach</div></details>
    </section>
    <section class="studio-build-note"><h2>A bench design, with a clear next step.</h2><div><p>Changing height, spacing or rail length updates the model, metal cut list and drilling schedule. Each size has its own printable parts. Adjusting frame dimensions within that family keeps its part interfaces unchanged. Travel and separated plates are inspection views; fabrication uses neutral datums.</p><p>Engineering verification, exact shock and wheel selection, harness anchors, guarding and a professional fit are required before any dog uses this prototype. A suspension setting does not prescribe hind-leg training or body support.</p><a href="/care" class="button-text">More about care and fitting</a></div></section>
  </div>
@endsection
