@extends('layouts/buddy')
@section('title', 'Dog wheelchairs')
<script server>
import { catalog, money } from '~/app/Storefront/Catalog'
export const sizeOptions = catalog.map(({ code, name, slug, weight, price, description }) => ({ code, name, slug, weight, description, priceLabel: money(price) }))
const requested = requestContext.query().size
export const initialSize = catalog.some(size => size.code === requested) ? requested : 'L'
const first = sizeOptions.find(size => size.code === initialSize)
const initialSlug = first?.slug || 'buddy-large'
defineClientPayload({ initialSize, sizeOptions })
</script>
<script client>
const selectedSize = state(initialSize)
const selected = derived(() => sizeOptions.find(size => size.code === selectedSize()) || sizeOptions[3]!)
</script>
@section('content')
  <div class="py-6 shell"><ProductFamilyNav active="wheelchairs" /></div>
  <section class="pb-16 product-layout shell">
    <div class="product-media"><figure class="product-photo"><img src="/images/chair-concept.webp" alt="Buddy Wheels forest-green rear-support wheelchair with modular aluminum frame" width="1280" height="853" fetchpriority="high"></figure>
      <div class="grid gap-5 grid-cols-2 mt-7"><div class="feature-rule"><h2 class="font-semibold text-base">A frame worth keeping.</h2><p class="mt-2 text-sm muted">Standard rails and replaceable connections put repairability at the center of the design.</p></div><div class="feature-rule"><h2 class="font-semibold text-base">Their body. Their fit.</h2><p class="mt-2 text-sm muted">Height, width and length adjustment are part of the design brief, from little dogs to gentle giants.</p></div></div>
      <div class="feature-rule"><h2 class="font-semibold text-base">For an active life outside.</h2><p class="mt-2 text-sm muted">All-terrain design starts with the places dogs love: grassy parks, neighborhood pavements and firm trails. Choose routes and activity with your care professional.</p></div>
    </div>
    <div class="product-info"><h1 class="section-title" data-product-name>{{ selected().name }}</h1><p class="mt-4 muted">A little rear support for the dog who still wants the long way home.</p><div class="flex gap-4 items-center mt-6"><p class="price" data-product-price>{{ selected().priceLabel }}</p><span class="text-xs muted">USD</span></div>
      <fieldset class="mt-7 p-0 border-0"><legend class="mb-3 font-semibold text-sm">Choose their size</legend><div class="grid gap-2 grid-cols-5">
        <button class="size-button" type="button" :aria-pressed="selectedSize() === 'XS' ? 'true' : 'false'" @click="selectedSize.set('XS')" data-size="XS">XS</button>
        <button class="size-button" type="button" :aria-pressed="selectedSize() === 'S' ? 'true' : 'false'" @click="selectedSize.set('S')" data-size="S">S</button>
        <button class="size-button" type="button" :aria-pressed="selectedSize() === 'M' ? 'true' : 'false'" @click="selectedSize.set('M')" data-size="M">M</button>
        <button class="size-button" type="button" :aria-pressed="selectedSize() === 'L' ? 'true' : 'false'" @click="selectedSize.set('L')" data-size="L">L</button>
        <button class="size-button" type="button" :aria-pressed="selectedSize() === 'XL' ? 'true' : 'false'" @click="selectedSize.set('XL')" data-size="XL">XL</button>
      </div></fieldset><p class="mt-3 text-sm" data-size-range>Size starting point: {{ selected().weight }}</p><a class="inline-flex mt-2 button-text" href="/fit-guide">Find their fit</a>
      <form id="chair-purchase" action="/api/cart/add" method="POST" class="mt-7"><input type="hidden" name="slug" value="{{ initialSlug }}" :value="selected().slug"><input type="hidden" name="redirect" value="/cart"><div class="flex flex-wrap gap-4 items-center"><QuantitySelector :value="1" :min="1" :max="5" label="Wheelchair quantity" /><span class="hidden md:block"><Button type="submit" variant="bare" class="button-primary">Add to basket</Button></span></div></form>
      <p class="mt-4 text-xs availability muted"><span class="availability-dot" aria-hidden="true"></span>Orders opening soon. Save your selection in the basket.</p>
      <div class="mt-7 faq"><details open><summary>The complete chair, considered.</summary><p>The kit design brings together a metal frame, replaceable printed connections, wheels, hardware, a front harness and padded rear support. Final contents and fit limits will be confirmed before orders open.</p></details><details><summary>Built around repair.</summary><p>Standard parts where they make sense. Printable parts where they can help. Our aim is a clear path to replace a worn component and keep the rest of the chair.</p></details><details><summary>What about suspension?</summary><p>Adjustable wheel suspension is part of our comfort research. Body support for rehabilitation is a separate, professionally guided adjustment. Suspension is not included in this configuration.</p></details><details><summary>Before their first walk.</summary><p>Ask a veterinarian or rehabilitation professional about suitability, posture and activity. A size choice alone cannot confirm that a rear-support chair is right for your dog.</p></details></div>
    </div>
  </section>
  <div class="mobile-purchase"><div><span class="text-xs muted">{{ selected().name }}</span><strong>{{ selected().priceLabel }}</strong></div><button form="chair-purchase" type="submit" class="button-primary">Add to basket</button></div>
@endsection
