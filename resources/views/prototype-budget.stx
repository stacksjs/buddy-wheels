@section('title', 'The complete one-off XL prototype budget')
<script server>
import { prototypeBudget, prototypeBudgetLines, developmentAllowances, budgetDate } from '~/app/Designs/PrototypeBudget'
import { money } from '~/app/Storefront/Catalog'
const device = prototypeBudgetLines.filter(line => line.group === 'device')
const metal = device.slice(0, 9)
const running = [...device.slice(9), ...prototypeBudgetLines.filter(line => line.group === 'consumables')]
const equipment = prototypeBudgetLines.filter(line => line.group === 'equipment')
const cases = (['low', 'base', 'high'] as const).map(which => prototypeBudget(which))
const base = prototypeBudget('base')
const owned = prototypeBudget('base', { equipment: false })
const totals = [
 { label: 'Device hardware', low: cases[0].device, base: base.device, high: cases[2].device },
 { label: 'Full spool + power', low: cases[0].consumables, base: base.consumables, high: cases[2].consumables },
 { label: 'Printer, tools + fixture', low: cases[0].equipment, base: base.equipment, high: cases[2].equipment },
 { label: 'Shipping allowance', low: cases[0].shipping, base: base.shipping, high: cases[2].shipping },
 { label: 'Illustrative tax reserve', low: cases[0].taxReserve, base: base.taxReserve, high: cases[2].taxReserve },
 { label: '20% build contingency', low: cases[0].contingency, base: base.contingency, high: cases[2].contingency },
]
</script>
