{
  "name": "buddy-wheels",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Repairable dog mobility, built with Stacks.",
  "engines": {
    "bun": "1.4.4"
  },
  "scripts": {
    "build:reset": "rm -rf node_modules && pantry install && ./buddy generate:types && ./buddy lint:fix",
    "buddy": "./buddy",
    "stacks": "./buddy",
    "setup": "./bootstrap",
    "fresh": "./buddy fresh",
    "clean": "./buddy clean",
    "upgrade": "./buddy upgrade",
    "dev": "./buddy dev",
    "development": "./buddy dev",
    "build": "./buddy build",
    "prod": "./buddy build",
    "deploy": "./buddy deploy",
    "lint": "./buddy lint",
    "lint:fix": "./buddy lint:fix",
    "format": "./buddy format",
    "format:check": "./buddy format:check",
    "serve": "./buddy serve",
    "make": "./buddy make",
    "make:component": "./buddy make:component",
    "make:function": "./buddy make:function",
    "make:database": "./buddy make:migration",
    "make:migration": "./buddy make:migration",
    "make:notification": "./buddy make:notification",
    "make:factory": "./buddy make:factory",
    "make:lang": "./buddy make:lang",
    "make:stack": "./buddy make:stack",
    "key:generate": "./buddy key:generate",
    "commit": "./buddy commit",
    "release": "./buddy release",
    "release:patch": "./buddy release --bump patch",
    "release:calendar": "./buddy release --bump calendar",
    "release:minor": "./buddy release --bump minor",
    "release:major": "./buddy release --bump major",
    "changelog": "./buddy changelog",
    "generate": "./buddy generate",
    "typecheck": "bun run typecheck:app",
    "typecheck:app": "bun x --bun tsc --noEmit -p tsconfig.json --pretty false",
    "typecheck:views": "bun x --bun stx typecheck --lib storage/framework/types/request-context.d.ts --lib storage/framework/types/browser-composables.d.ts --lib app/UI/FinishControls.d.ts 'resources/**/*.stx'",
    "typecheck:clean": "bunx --bun rimraf storage/framework/.cache/typescript",
    "types:check": "bun run typecheck",
    "types:fix": "./buddy types:fix",
    "test": "./buddy test",
    "test:ui": "./buddy test:ui",
    "test:coverage": "./buddy test:coverage",
    "test:types": "./buddy test:types",
    "bud": "./buddy",
    "probe:integrations": "./buddy integrations:probe",
    "finance": "bun scripts/finance.ts",
    "test:browser": "bun scripts/qa.ts",
    "test:studio": "bun scripts/qa-studio.ts",
    "images": "bun scripts/images.ts",
    "finance:prototype": "bun scripts/prototype-cost.ts",
    "guides:art": "bun scripts/measurement-art.ts",
    "guides:pdf": "bun scripts/export-guides.ts",
    "test:fit": "bun scripts/qa-fit.ts",
    "test:standard": "bun scripts/qa-standard.ts",
    "test:spring": "bun scripts/qa-spring.ts",
    "test:finish": "bun scripts/qa-finish.ts"
  },
  "dependencies": {
    "@stacksjs/actions": "^0.75.584",
    "@stacksjs/browser": "0.75.584",
    "@stacksjs/cli": "0.75.584",
    "@stacksjs/database": "0.75.584",
    "@stacksjs/defaults": "0.75.584",
    "@stacksjs/env": "^0.75.584",
    "@stacksjs/image": "0.75.584",
    "@stacksjs/orm": "0.75.584",
    "@stacksjs/path": "^0.75.584",
    "@stacksjs/stx": "0.2.875",
    "stacks": "^0.75.584"
  },
  "workspaces": [
    "storage/framework",
    "storage/framework/libs/*",
    "storage/framework/views/*"
  ],
  "git-hooks": {
    "pre-commit": {
      "staged-lint": {
        "*.{js,ts,json,yaml,yml,md}": "bun x --bun pickier lint --fix"
      }
    },
    "commit-msg": "bun x gitlint --edit \"$1\""
  },
  "devDependencies": {
    "@actions/expressions": "0.3.61",
    "@stacksjs/components": "0.2.875",
    "@stacksjs/testing": "0.75.584",
    "better-dx": "^0.2.40",
    "bun-plugin-stx": "0.2.876"
  },
  "author": "Chris Breuer <chris@stacksjs.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stacksjs/buddy-wheels.git"
  },
  "homepage": "https://buddywheels.org",
  "license": "UNLICENSED"
}
